{
  "_version": "1.65.0",
  "sap.app": {
    "id": "rfqportal",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:basic",
      "version": "1.18.0",
      "toolsId": "e20cd448-3e23-41f7-a6cd-c7f99403f625"
    },
    "dataSources": {
      "referenceService": {
        "uri": "/odata/v4/reference/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "adminService": {
        "uri": "/odata/v4/admin/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "buyerService": {
        "uri": "/odata/v4/buyer/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      },
      "vendorService": {
        "uri": "odata/v4/vendor/",
        "type": "OData",
        "settings": {
          "annotations": [],
          "odataVersion": "4.0"
        }
      }
    },
    "crossNavigation": {
      "inbounds": {
        "rfq_portal-display": {
          "semanticObject": "rfq_portal",
          "action": "display",
          "signature": {
            "parameters": {},
            "additionalParameters": "allowed"
          }
        }
      }
    }
  },
  "sap.ui5": {
    "dependencies": {
      "minUI5Version": "1.136.2",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.tnt": {}
      }
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "settings": {
          "bundleName": "rfqportal.i18n.i18n"
        }
      },
      "device": {
        "type": "sap.ui.model.json.JSONModel"
      }
    },
    "routing": {
      "config": {
        "routerClass": "sap.m.routing.Router",
        "controlAggregation": "pages",
        "controlId": "app_page",
        "transition": "slide",
        "type": "View",
        "viewType": "XML",
        "path": "rfqportal.view",
        "async": true
      },
      "routes": [
        {
          "name": "RouteApp",
          "pattern": "",
          "target": "TargetApp"
        },
        {
          "name": "RouteAppAdmin",
          "pattern": "admin",
          "target": "TargetAdmin"
        },
        {
          "name": "RouteAppBuyer",
          "pattern": "buyer",
          "target": "TargetBuyer"
        },
        {
          "name": "RouteAppVendor",
          "pattern": "vendor",
          "target": "TargetVendor"
        }
      ],
      "targets": {
        "TargetApp": {
          "viewName": "App",
          "viewPath": "rfqportal.view",
          "viewType": "XML",
          "controlAggregation": "pages",
          "controlId": "app_page"
        },
        "TargetAdmin": {
          "type": "Component",
          "usage": "adminComponent",
          "controlAggregation": "pages",
          "controlId": "app_page"
        },
        "TargetBuyer": {
          "type": "Component",
          "usage": "buyerComponent",
          "controlAggregation": "pages",
          "controlId": "app_page"
        },
        "TargetVendor": {
          "type": "Component",
          "usage": "vendorComponent",
          "controlAggregation": "pages",
          "controlId": "app_page"
        }
      }
    },
    "componentUsages": {
      "adminComponent": {
        "name": "rfqportal.components.admin",
        "lazy": true
      },
      "buyerComponent": {
        "name": "rfqportal.components.buyer",
        "lazy": true
      },
      "vendorComponent": {
        "name": "rfqportal.components.vendor",
        "lazy": true
      }
    },
    "rootView": {
      "viewName": "rfqportal.view.App",
      "type": "XML",
      "async": true,
      "id": "App"
    }
  },
  "sap.cloud": {
    "public": true,
    "service": "RFQ.service"
  }
}