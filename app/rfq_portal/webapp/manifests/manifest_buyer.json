{
    "_version": "1.65.0",
    "sap.app": {
        "id": "rfqportal.buyer",
        "type": "component",
        "title": "RFQ Portal - Buyer Module",
        "description": "Buyer module for RFQ Portal",
        "dataSources": {
            "buyerService": {
                "uri": "/odata/v4/buyer/",
                "type": "OData",
                "settings": {
                    "annotations": [],
                    "odataVersion": "4.0"
                }
            },
            "referenceService": {
                "uri": "/odata/v4/reference/",
                "type": "OData",
                "settings": {
                    "annotations": [],
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui5": {
        "dependencies": {
            "minUI5Version": "1.136.2",
            "libs": {
                "sap.m": {},
                "sap.ui.core": {},
                "sap.tnt": {},
                "sap.ui.mdc": {},
                "sap.f": {},
                "sap.uxap": {}
            }
        },
        "models": {
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "rfqportal.i18n.i18n"
                }
            },
            "buyerModel": {
                "dataSource": "buyerService",
                "type": "sap.ui.model.odata.v4.ODataModel",
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            },
            "referenceModel": {
                "dataSource": "referenceService",
                "type": "sap.ui.model.odata.v4.ODataModel",
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "controlAggregation": "pages",
                "controlId": "buyerApp",
                "transition": "slide",
                "type": "View",
                "viewType": "XML",
                "path": "rfqportal.view.viewBuyer",
                "async": true
            },
            "routes": [
                {
                    "name": "BuyerMain",
                    "pattern": "",
                    "target": "BuyerApp"
                },
                {
                    "name": "BuyerRFQList",
                    "pattern": "rfq-list",
                    "target": "RFQList"
                },
                {
                    "name": "BuyerRFQCreate",
                    "pattern": "rfq-create",
                    "target": "RFQCreate"
                },
                {
                    "name": "BuyerRFQDetail",
                    "pattern": "rfq-detail/{rfqId}",
                    "target": "RFQDetail"
                },
                {
                    "name": "BuyerQuotations",
                    "pattern": "quotations",
                    "target": "Quotations"
                }
            ],
            "targets": {
                "BuyerApp": {
                    "viewName": "AppBuyer",
                    "viewPath": "rfqportal.view.viewBuyer",
                    "viewType": "XML",
                    "controlAggregation": "pages",
                    "controlId": "buyerApp"
                },
                "RFQList": {
                    "viewName": "RFQList",
                    "viewPath": "rfqportal.view.viewBuyer",
                    "viewType": "XML",
                    "controlAggregation": "pages",
                    "controlId": "buyerContent",
                    "parent": "BuyerApp"
                },
                "RFQCreate": {
                    "viewName": "RFQCreate",
                    "viewPath": "rfqportal.view.viewBuyer",
                    "viewType": "XML",
                    "controlAggregation": "pages",
                    "controlId": "buyerContent",
                    "parent": "BuyerApp"
                },
                "RFQDetail": {
                    "viewName": "RFQDetail",
                    "viewPath": "rfqportal.view.viewBuyer",
                    "viewType": "XML",
                    "controlAggregation": "pages",
                    "controlId": "buyerContent",
                    "parent": "BuyerApp"
                },
                "Quotations": {
                    "viewName": "QuotationView",
                    "viewPath": "rfqportal.view.viewBuyer",
                    "viewType": "XML",
                    "controlAggregation": "pages",
                    "controlId": "buyerContent",
                    "parent": "BuyerApp"
                }
            }
        },
        "componentUsages": {
            "reusableComponent": {
                "name": "rfqportal.component.reusable"
            }
        }
    }
}