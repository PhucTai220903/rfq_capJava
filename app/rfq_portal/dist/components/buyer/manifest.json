{
    "sap.app": {
        "id": "rfqportal.components.buyer",
        "type": "application",
        "dataSources": {
            "buyerService": {
                "uri": "odata/v4/buyer/",
                "type": "OData",
                "settings": {
                    "odataVersion": "4.0"
                }
            }
        }
    },
    "sap.ui5": {
        "models": {
            "": {
                "dataSource": "buyerService",
                "type": "sap.ui.model.odata.v4.ODataModel",
                "settings": {
                    "synchronizationMode": "None",
                    "operationMode": "Server",
                    "autoExpandSelect": true,
                    "earlyRequests": true
                }
            },
            "i18n": {
                "type": "sap.ui.model.resource.ResourceModel",
                "settings": {
                    "bundleName": "rfqportal.components.buyer.i18n.i18n"
                }
            }
        },
        "routing": {
            "config": {
                "routerClass": "sap.m.routing.Router",
                "viewType": "XML",
                "async": true,
                "path": "rfqportal.components.buyer.view"
            },
            "routes": [
                {
                    "name": "BuyerMain",
                    "pattern": "",
                    "target": "BuyerApp"
                },
                {
                    "name": "Dashboard",
                    "pattern": "buyer/rfq-list",
                    "target": "Dashboard"
                },
                {
                    "name": "CreateRFQ",
                    "pattern": "buyer/rfq-create",
                    "target": "RFQCreate"
                },
                {
                    "name": "BuyerRFQDetail",
                    "pattern": "buyer/rfq-detail/{rfqId}",
                    "target": "RFQDetail"
                },
                {
                    "name": "BuyerQuotations",
                    "pattern": "buyer/quotations",
                    "target": "Quotations"
                }
            ],
            "targets": {
                "BuyerApp": {
                    "viewName": "AppBuyer",
                    "controlAggregation": "pages",
                    "controlId": "app_buyer"
                },
                "Dashboard": {
                    "viewName": "Dashboard",
                    "controlAggregation": "pages",
                    "controlId": "app_buyer"
                },
                "RFQCreate": {
                    "viewName": "CreateRFQ",
                    "controlAggregation": "pages",
                    "controlId": "app_buyer"
                },
                "RFQDetail": {
                    "viewName": "RFQDetail",
                    "controlAggregation": "pages",
                    "controlId": "app_buyer"
                },
                "Quotations": {
                    "viewName": "QuotationView",
                    "controlAggregation": "pages",
                    "controlId": "app_buyer"
                }
            }
        },
        "rootView": {
            "viewName": "rfqportal.components.buyer.view.AppBuyer",
            "type": "XML",
            "async": true
        }
    }
}