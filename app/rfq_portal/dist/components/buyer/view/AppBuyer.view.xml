<mvc:View controllerName="rfqportal.components.buyer.controller.AppBuyer"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core">

    <tnt:ToolPage id="toolPage_buyer">

        <tnt:header>
            <tnt:ToolHeader>
                <Button icon="sap-icon://menu2" press="onSideNavButtonPress" />
                <Image src="images/logo.png" height="50px" />
                <Title text="Application - Buyer" level="H2" />
                <ToolbarSpacer />
                <Button icon="sap-icon://search"/>
                <Button icon="sap-icon://bell"/>
                <Select id="languageSelect" selectedKey="{/selectedLanguage}" change="onLanguageChange">
                    <core:Item key="en" text="English" />
                    <core:Item key="vi" text="Tiếng Việt" />
                    <core:Item key="kr" text="한국어" />
                </Select>
            </tnt:ToolHeader>
        </tnt:header>

        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation_buyer" expanded="false">
                <tnt:NavigationList>
                    <tnt:NavigationListItem key="parent-modules" text="{i18n>modules}" icon="sap-icon://product" selectable="false">
                        <tnt:NavigationListItem key="dashboard" text="{i18n>dashboard}" />
                        <tnt:NavigationListItem key="create-rfq" text="{i18n>createRFQ}" />
                        <tnt:NavigationListItem key="my-rfq" text="{i18n>myRFQs}" />
                        <tnt:NavigationListItem key="quotations" text="{i18n>quotations}" />
                        <tnt:NavigationListItem key="purchase-order" text="{i18n>purchaseOrders}" />
                        <tnt:NavigationListItem key="vendor-management" text="{i18n>vendorManagement}" />
                        <tnt:NavigationListItem key="contracts" text="{i18n>contracts}" />
                        <tnt:NavigationListItem key="reports" text="{i18n>reports}" />
                    </tnt:NavigationListItem>
                    <tnt:NavigationListItem key="parent-general" text="{i18n>general}" icon="sap-icon://settings" selectable="false">
                        <tnt:NavigationListItem key="profile" text="{i18n>profile}" />
                        <tnt:NavigationListItem key="preferences" text="{i18n>preferences}" />
                    </tnt:NavigationListItem>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <tnt:mainContents>
            <ScrollContainer vertical="true" height="100%">
                <App id="app_buyer" class="sapUiSizeCompact" />
            </ScrollContainer>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>