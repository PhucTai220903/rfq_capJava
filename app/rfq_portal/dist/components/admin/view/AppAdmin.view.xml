<mvc:View controllerName="rfqportal.components.admin.controller.AppAdmin" displayBlock="true"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:tnt="sap.tnt"
    xmlns:core="sap.ui.core">

    <tnt:ToolPage id="toolPage">

        <!-- Fixed Custom Header -->
        <tnt:header xmlns:tnt="sap.tnt"
            xmlns:m="sap.m">
            <tnt:ToolHeader>
                <tnt:content>
                    <m:Button icon="sap-icon://menu2" press="onSideNavButtonPress" />
                    <m:Image src="images/logo.png" height="50px" />
                    <m:Title text="{i18n>applicationTitle}" level="H2" />
                    <m:ToolbarSpacer />
                    <m:Button icon="sap-icon://search"/>
                    <m:Button icon="sap-icon://bell"/>
                    <m:Select id="languageSelect" selectedKey="{oModel>/selectedLanguage}" change="onLanguageChange">
                        <core:Item key="en" text="English" />
                        <core:Item key="vi" text="Tiếng Việt" />
                        <core:Item key="kr" text="한국어" />
                    </m:Select>
                </tnt:content>
            </tnt:ToolHeader>
        </tnt:header>

        <!-- Fixed Side Navigation -->
        <tnt:sideContent>
            <tnt:SideNavigation id="sideNavigation" expanded="false">
                <tnt:NavigationList>
                    <tnt:NavigationListItem key="parent-modules" text="{i18n>modules}" icon="sap-icon://product" selectable="false">
                        <tnt:NavigationListItem key="dashboard" text="{i18n>dashboard}" />
                        <tnt:NavigationListItem key="purchase-request" text="{i18n>purchaseRequest}" />
                        <tnt:NavigationListItem key="rfq" text="{i18n>requestForQuotation}" />
                        <tnt:NavigationListItem key="purchase-order" text="{i18n>purchaseOrder}" />
                        <tnt:NavigationListItem key="contract" text="{i18n>contract}" />
                        <tnt:NavigationListItem key="vendor" text="{i18n>vendor}" />
                        <tnt:NavigationListItem key="inventory" text="{i18n>inventory}" />
                        <tnt:NavigationListItem key="reporting" text="{i18n>reporting}" />
                    </tnt:NavigationListItem>
                    <tnt:NavigationListItem key="parent-general" text="{i18n>general}" icon="sap-icon://settings" selectable="false">
                        <tnt:NavigationListItem key="account" text="{i18n>account}" />
                    </tnt:NavigationListItem>
                </tnt:NavigationList>
            </tnt:SideNavigation>
        </tnt:sideContent>

        <!-- Main Content Area -->
        <tnt:mainContents>
            <ScrollContainer vertical="true" height="100%">
                <App id="app_admin" class="sapUiSizeCompact" />
            </ScrollContainer>
        </tnt:mainContents>

    </tnt:ToolPage>
</mvc:View>